DATABASE_URL="postgresql://envshare:envshare_dev_password@localhost:5432/envshare"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"

# 64 hex characters (32 bytes). Generate it with the same command, and use a DIFFERENT value from JWT_SECRET.
# If this key is lost or changed, every Sensitive value becomes unrecoverable.
ENCRYPTION_KEY="64-hex-characters"