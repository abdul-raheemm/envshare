generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  name             String
  passwordHash     String
  createdAt        DateTime        @default(now())
  ownedProjects    Project[]
  memberships      ProjectMember[]
  updatedVariables Variable[]
  historyEntries   HistoryEntry[]
  revealLogs       RevealLog[]
}

model Project {
  id           String          @id @default(cuid())
  name         String
  ownerId      String
  createdAt    DateTime        @default(now())
  owner        User            @relation(fields: [ownerId], references: [id])
  members      ProjectMember[]
  environments Environment[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
}

model Environment {
  id         String         @id @default(cuid())
  projectId  String
  name       String
  createdAt  DateTime       @default(now())
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variables  Variable[]
  history    HistoryEntry[]
  revealLogs RevealLog[]

  @@unique([projectId, name])
}

model Variable {
  id            String      @id @default(cuid())
  environmentId String
  key           String
  value         String
  isSensitive   Boolean     @default(false)
  iv            String?
  authTag       String?
  version       Int         @default(1)
  updatedById   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  updatedBy     User        @relation(fields: [updatedById], references: [id])

  @@unique([environmentId, key])
}

enum HistoryAction {
  CREATE
  UPDATE
  DELETE
  TYPE_CHANGE
}

enum RevealSource {
  VARIABLE
  HISTORY
}

model HistoryEntry {
  id             String        @id @default(cuid())
  environmentId  String
  batchId        String
  action         HistoryAction
  key            String // a plain string, NOT a foreign key: survives variable deletion
  oldKey         String? // only set on renames
  oldValue       String? // set only when the value changed or was deleted
  oldIv          String? // non-null means oldValue is encrypted
  oldAuthTag     String?
  newValue       String? // set only when the value changed or was created
  newIv          String? // non-null means newValue is encrypted
  newAuthTag     String?
  oldIsSensitive Boolean? // type snapshots, for display
  newIsSensitive Boolean?
  changedById    String
  changedAt      DateTime      @default(now())
  environment    Environment   @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  changedBy      User          @relation(fields: [changedById], references: [id])

  @@index([environmentId, changedAt])
  @@index([environmentId, key])
  @@index([batchId])
}

model RevealLog {
  id            String       @id @default(cuid())
  environmentId String
  key           String // a plain string, not a foreign key
  source        RevealSource
  userId        String
  revealedAt    DateTime     @default(now())
  environment   Environment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id])

  @@index([environmentId, revealedAt])
}
